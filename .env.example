# ─── Xerin Marketplace — Environment ───
# Copy this file to .env (local dev) or .env.production (build/deploy).
# Production values are prefilled — adjust SITE_URL if your domain differs.

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://xerinmarketplace.com
PORT=3000
HOSTNAME=0.0.0.0

# ── Backend API (production) ──
NEXT_PUBLIC_API_BASE_URL=https://api.xerinmarketplace.com/api/v1
NEXT_PUBLIC_API_DOCS_URL=https://api.xerinmarketplace.com/docs

# ── Local development (uncomment when running the backend locally) ──
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/docs

# ── Google OAuth (optional) ──
# Create a Web OAuth 2.0 Client in Google Cloud Console → APIs & Services → Credentials.
# The ID (not the secret) is public by design — it only identifies the client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
