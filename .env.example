# ─── Xerin Marketplace — Environment Variables ───
# Copy this file to .env (local) or .env.production (VPS)
# and fill in the real values.

# ── Site Configuration ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
HOSTNAME=0.0.0.0

# ── Xerin Marketplace API ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/docs

# ── NextAuth Configuration ──
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key-here

# ── Email Provider (e.g., SendGrid, Nodemailer) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password

# ── Sanity Configuration (if using) ──
# SANITY_PROJECT_ID=your-project-id
# SANITY_DATASET=production
# SANITY_API_TOKEN=your-api-token
